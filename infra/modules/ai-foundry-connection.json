{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "9056846730061212002"
    }
  },
  "parameters": {
    "hubName": {
      "type": "string",
      "metadata": {
        "description": "The name of the AI Foundry Hub"
      }
    },
    "connectionName": {
      "type": "string",
      "metadata": {
        "description": "The name of the connection"
      }
    },
    "openaiEndpoint": {
      "type": "string",
      "metadata": {
        "description": "The Azure OpenAI endpoint URL"
      }
    },
    "openaiApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "The Azure OpenAI API key"
      }
    },
    "openaiResourceId": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the Azure OpenAI account"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.MachineLearningServices/workspaces/connections",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('hubName'), parameters('connectionName'))]",
      "properties": {
        "category": "AzureOpenAI",
        "target": "[parameters('openaiEndpoint')]",
        "authType": "ApiKey",
        "isSharedToAll": true,
        "credentials": {
          "key": "[parameters('openaiApiKey')]"
        },
        "metadata": {
          "ApiType": "Azure",
          "ResourceId": "[parameters('openaiResourceId')]"
        }
      }
    }
  ],
  "outputs": {
    "id": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the OpenAI connection"
      },
      "value": "[resourceId('Microsoft.MachineLearningServices/workspaces/connections', parameters('hubName'), parameters('connectionName'))]"
    },
    "name": {
      "type": "string",
      "metadata": {
        "description": "The name of the OpenAI connection"
      },
      "value": "[parameters('connectionName')]"
    }
  }
}
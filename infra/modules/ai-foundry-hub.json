{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "10912828174544021867"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "The name of the AI Foundry Hub"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the resource"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to the resource"
      }
    },
    "storageAccountId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional storage account resource ID. If not provided, hub will auto-create storage"
      }
    },
    "keyVaultId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional key vault resource ID. If not provided, hub will auto-create key vault"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2024-04-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "Hub",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[parameters('name')]",
        "description": "AI Foundry Hub for Travel Agent Application",
        "storageAccount": "[if(not(empty(parameters('storageAccountId'))), parameters('storageAccountId'), null())]",
        "keyVault": "[if(not(empty(parameters('keyVaultId'))), parameters('keyVaultId'), null())]",
        "publicNetworkAccess": "Enabled"
      }
    }
  ],
  "outputs": {
    "id": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the AI Foundry Hub"
      },
      "value": "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('name'))]"
    },
    "name": {
      "type": "string",
      "metadata": {
        "description": "The name of the AI Foundry Hub"
      },
      "value": "[parameters('name')]"
    },
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "The principal ID of the hub managed identity"
      },
      "value": "[reference(resourceId('Microsoft.MachineLearningServices/workspaces', parameters('name')), '2024-04-01', 'full').identity.principalId]"
    }
  }
